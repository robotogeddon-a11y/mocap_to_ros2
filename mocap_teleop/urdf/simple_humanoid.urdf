<?xml version="1.0"?>
<!-- Minimal upper-body humanoid for RViz. Arm hangs along -z at zero.
     Joint limits must match LIMITS in mocap_player.py. -->
<robot name="simple_humanoid">
  <material name="body"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="limb"><color rgba="0.85 0.85 0.85 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.15 0.32 0.45"/></geometry>
      <material name="body"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.34"/>
      <geometry><sphere radius="0.1"/></geometry>
      <material name="limb"/>
    </visual>
  </link>

  <!-- ===== Left arm ===== -->
  <link name="left_shoulder_pitch_link"/>
  <link name="left_shoulder_roll_link"/>
  <link name="left_upper_arm_link">
    <visual>
      <origin xyz="0 0 -0.14"/>
      <geometry><cylinder radius="0.035" length="0.28"/></geometry>
      <material name="limb"/>
    </visual>
  </link>
  <link name="left_forearm_link">
    <visual>
      <origin xyz="0 0 -0.125"/>
      <geometry><cylinder radius="0.03" length="0.25"/></geometry>
      <material name="limb"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.27"/>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="body"/>
    </visual>
  </link>

  <joint name="left_shoulder_pitch_joint" type="revolute">
    <parent link="base_link"/><child link="left_shoulder_pitch_link"/>
    <origin xyz="0 0.2 0.2"/><axis xyz="0 1 0"/>
    <limit lower="-3.1" upper="1.2" effort="10" velocity="5"/>
  </joint>
  <joint name="left_shoulder_roll_joint" type="revolute">
    <parent link="left_shoulder_pitch_link"/><child link="left_shoulder_roll_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="2.9" effort="10" velocity="5"/>
  </joint>
  <joint name="left_shoulder_yaw_joint" type="revolute">
    <parent link="left_shoulder_roll_link"/><child link="left_upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="10" velocity="5"/>
  </joint>
  <joint name="left_elbow_joint" type="revolute">
    <parent link="left_upper_arm_link"/><child link="left_forearm_link"/>
    <origin xyz="0 0 -0.28"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.6" effort="10" velocity="5"/>
  </joint>

  <!-- ===== Right arm (roll/yaw axes mirrored) ===== -->
  <link name="right_shoulder_pitch_link"/>
  <link name="right_shoulder_roll_link"/>
  <link name="right_upper_arm_link">
    <visual>
      <origin xyz="0 0 -0.14"/>
      <geometry><cylinder radius="0.035" length="0.28"/></geometry>
      <material name="limb"/>
    </visual>
  </link>
  <link name="right_forearm_link">
    <visual>
      <origin xyz="0 0 -0.125"/>
      <geometry><cylinder radius="0.03" length="0.25"/></geometry>
      <material name="limb"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.27"/>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="body"/>
    </visual>
  </link>

  <joint name="right_shoulder_pitch_joint" type="revolute">
    <parent link="base_link"/><child link="right_shoulder_pitch_link"/>
    <origin xyz="0 -0.2 0.2"/><axis xyz="0 1 0"/>
    <limit lower="-3.1" upper="1.2" effort="10" velocity="5"/>
  </joint>
  <joint name="right_shoulder_roll_joint" type="revolute">
    <parent link="right_shoulder_pitch_link"/><child link="right_shoulder_roll_link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.3" upper="2.9" effort="10" velocity="5"/>
  </joint>
  <joint name="right_shoulder_yaw_joint" type="revolute">
    <parent link="right_shoulder_roll_link"/><child link="right_upper_arm_link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-2.6" upper="2.6" effort="10" velocity="5"/>
  </joint>
  <joint name="right_elbow_joint" type="revolute">
    <parent link="right_upper_arm_link"/><child link="right_forearm_link"/>
    <origin xyz="0 0 -0.28"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.6" effort="10" velocity="5"/>
  </joint>
</robot>
